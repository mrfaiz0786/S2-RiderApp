# PUBLIC mobile configuration only. These values are readable from the app bundle.
# The backend team owns authentication, KYC, storage, notifications and payments.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_DATA_MODE=mock
# Connected mode: HTTPS SERVER ORIGIN ONLY (not /api/rider-app or /api/auth).
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_API_TIMEOUT_MS=15000
# Native notification reception only; sending credentials stay with the backend team.
EXPO_PUBLIC_PUSH_ENABLED=false
# EAS may supply a file-type GOOGLE_SERVICES_JSON when Android push is approved.
# Never place provider secrets, static bearer tokens, SMTP or database keys here.
