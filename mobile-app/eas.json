{
  "cli": { "version": ">= 24.6.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "EXPO_PUBLIC_APP_ENV": "development", "EXPO_PUBLIC_DATA_MODE": "mock" },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": { "EXPO_PUBLIC_APP_ENV": "staging", "EXPO_PUBLIC_DATA_MODE": "mock" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_APP_ENV": "production", "EXPO_PUBLIC_DATA_MODE": "api" },
      "android": { "buildType": "app-bundle" }
    }
  }
}
